{
  "name": "aweme-lens",
  "version": "1.0.0",
  "private": true,
  "description": "A provenance-first TikTok profile and post inspector with a safe mock mode and evidence-bounded legacy adapters.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "json-bigint": "1.0.0",
    "next": "15.5.21",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "server-only": "0.0.1",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@types/json-bigint": "1.0.4",
    "@types/node": "22.15.30",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "autoprefixer": "10.4.21",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.21",
    "postcss": "8.5.4",
    "prettier": "3.5.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
