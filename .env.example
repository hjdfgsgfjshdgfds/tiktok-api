# Safe default. No TikTok credentials or live network calls are needed.
LOOKUP_MODE=mock

# Server behavior
ALLOW_RAW_VIEWER=true
LOOKUP_BUDGET_MS=45000
REQUEST_TIMEOUT_MS=8000
TARGET_MISSING_RETRIES=1
CACHE_TTL_SECONDS=60
CACHE_MAX_ENTRIES=100
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60
UPSTREAM_COOLDOWN_SECONDS=60

# Experimental legacy-live mode only.
# The connected repository requires an external signURL implementation and does not
# contain a current signer. The URL below is an operator-supplied server-side bridge.
# Set LOOKUP_MODE=legacy-live only after all required values are configured.
TIKTOK_LEGACY_BASE_URL=https://api2.musical.ly/
TIKTOK_SIGNER_URL=
TIKTOK_SIGNER_TOKEN=
TIKTOK_DEVICE_ID=
TIKTOK_FP=
TIKTOK_IID=
TIKTOK_OPENUDID=

# Optional. Never expose this to the browser or commit it.
TIKTOK_COOKIE=
